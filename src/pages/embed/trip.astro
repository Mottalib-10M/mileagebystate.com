---
/** Embeddable page (iframe): the calculator alone. noindex, outside the sitemap (astro.config). */
import '../../styles/global.css';
import Tool from '../../components/Tool.astro';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
const target = '/en/';
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Per diem and mileage trip calculator (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}${target}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <Tool kind="trip" idPrefix="embed" methodHref={`${SITE_URL}/en/method/`} />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}${target}`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a> · computed in your browser · federal rates, not your employer's policy</p>
  </body>
</html>
