---
/**
 * Per diem in one state: the state's FY2027 figures in a strip, the trip calculator preset on the state's
 * dearest GSA area, the folded answer, the prose written for this state, then the generated table of every
 * GSA area of the state in FY2027 and FY2026, marked data-chrome because its form repeats (RECETTE §6.4).
 */
import PageLayout from '../layouts/PageLayout.astro';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import { route, ROUTES } from '../i18n/routes';
import { label } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById, statePageById, stateId, STATE_PILLAR } from '../lib/pages';
import { helpers, SOURCES, table } from '../lib/helpers';
import { KIT as K } from '../lib/kit';
import { T, destIndex } from '../lib/data';
import { usd, day } from '../lib/fmt';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME, LAST_UPDATED } from '../data/site-config';
import type { StateDef } from '../lib/page-types';
interface Props { def: StateDef }
const { def } = Astro.props;
const lang = 'en';
const ui = t(lang);
const sum = K.stateSummary(def.slug);
const S = sum.s;
const id = stateId(def.slug);
const path = route(id, lang);
const h1 = `Per diem rates in ${S.name}, FY2027`;
const jsonLd = [webApplicationSchema({ name: h1, description: def.description, path, lang }), articleSchema({ title: h1, description: def.description, path, lang }), webPageSchema({ name: h1, description: def.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: 'Per diem rates', path: route(STATE_PILLAR, lang) }, { name: S.name, path }])];
if (def.faqs.length) jsonLd.push(faqSchema(def.faqs, lang));
const card = (rid: string) => pageById(rid)?.card ?? (statePageById(rid) ? `GSA lodging and M&IE in every ${K.stateRef(statePageById(rid)!.slug).name} area, FY2027` : '');
const related = def.related.filter((r) => ROUTES.some((x) => x.id === r)).map((r) => ({ href: route(r, lang), name: label(r), description: card(r) }));
const sources = [...(def.extraSources ?? []), ...['gsa_files', 'gsa_highlights', 'gsa_mie', 'ftr_301_11'].map((k) => ({ name: SOURCES[k].label, url: SOURCES[k].url }))];
const parts = def.body(helpers()).split(/<!--mini:([A-Za-z0-9_-]+)(?:\|([A-Za-z0-9+/=]+))?-->/);
const decode = (b?: string) => (b ? Buffer.from(b, 'base64').toString('utf8') : undefined);
const pickName = def.dest ?? sum.top?.name;
const di = pickName ? destIndex(S.abbr, pickName) : -1;
const dd = di >= 0 ? T.dest[di] : undefined;
const dest = dd ? { label: `${dd.name}, ${dd.st}`, detail: `GSA area: ${dd.counties}`, d27: dd.fy['2027'] ? di : -1, d26: dd.fy['2026'] ? di : -1 } : { label: `${S.name}, standard CONUS rate`, detail: 'Every county of the state', d27: -1, d26: -1 };
const rows = sum.list.map((x) => [x.name, x.counties, x.low === x.high ? usd(x.high) : `${usd(x.low)} to ${usd(x.high)}`, usd(x.mie), x.prev ? (x.prev.low === x.prev.high ? usd(x.prev.high) : `${usd(x.prev.low)} to ${usd(x.prev.high)}`) : 'new in FY2027']);
rows.push(['Rest of the state', 'All other counties', usd(sum.std.lodging), usd(sum.std.mie), usd(K.std(2026).lodging)]);
---
<PageLayout title={def.title} description={def.description} lang={lang} jsonLd={jsonLd} faqs={def.faqs} related={related} sources={sources} breadcrumbs={[{ label: 'Per diem rates', href: route(STATE_PILLAR, lang) }, { label: S.name }]}>
  <article>
    <header class="mb-5">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent-700">Per diem · {S.abbr} · GSA FY2027 from October 1, 2026</p>
      <h1 class="mt-1 font-serif text-3xl font-bold text-navy-900 md:text-4xl">{h1}</h1>
      <p class="mt-3 text-lg text-navy-700">{def.intro}</p>
      <p class="mt-3 text-sm text-navy-600">GSA FY2027 ZIP file published <time datetime="2026-09-03">{day('2026-09-03')}</time> · rates checked <time datetime={LAST_UPDATED}>{day(LAST_UPDATED)}</time> · {ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('method', lang)} class="underline hover:text-navy-900">{label('method')}</a></p>
    </header>
    <dl data-chrome class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="border-l-4 border-accent-600 pl-3"><dt class="text-xs text-navy-600">GSA areas above the standard rate</dt><dd class="tabular-nums text-xl font-bold text-navy-900">{sum.count}</dd></div>
      <div class="border-l-4 border-accent-600 pl-3"><dt class="text-xs text-navy-600">Highest lodging maximum</dt><dd class="tabular-nums text-xl font-bold text-navy-900">{sum.top ? usd(sum.top.high) : usd(sum.std.lodging)}</dd></div>
      <div class="border-l-4 border-accent-600 pl-3"><dt class="text-xs text-navy-600">Where</dt><dd class="text-base font-semibold text-navy-900">{sum.top ? sum.top.name : 'whole state'}</dd></div>
      <div class="border-l-4 border-accent-600 pl-3"><dt class="text-xs text-navy-600">Everywhere else</dt><dd class="tabular-nums text-xl font-bold text-navy-900">{usd(sum.std.lodging)} + {usd(sum.std.mie)}</dd></div>
    </dl>
    <div data-outil class="mb-8"><Tool kind="perdiem" dest={dest} idPrefix={`${S.abbr.toLowerCase()}pd`} /></div>
    <Clamp text={def.resume} lang={lang} id={`clamp-st-${def.slug}`} class="mb-8" />
    <div class="prose prose-slate max-w-none prose-headings:font-serif">
      {parts.map((p, i) => i % 3 === 0 ? <Fragment set:html={p ?? ''} /> : i % 3 === 1 ? <MiniSim client:load kind={p} arg={decode(parts[i + 1])} href={route('home', lang)} /> : null)}
    </div>
    <section data-chrome class="mt-10">
      <h2 class="font-serif text-2xl font-bold text-navy-900">Every GSA area in {S.name}: FY2027 against FY2026</h2>
      <Fragment set:html={table(['GSA area', 'Counties or limits', 'Lodging FY2027', 'M&IE', 'Lodging FY2026'], rows, `GSA per diem files. Lodging is the nightly maximum; seasonal areas change by month. The five M&IE tiers did not change between the two years; an area can still move from one tier to another.`, ['l', 'l', 'r', 'r', 'r'])} />
    </section>
  </article>
</PageLayout>
