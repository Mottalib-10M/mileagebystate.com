---
/** Every tool page (src/content/pages/) and every state per diem page (src/content/states/). */
import ContentPage from '../../components/ContentPage.astro';
import StatePage from '../../components/StatePage.astro';
import { PAGES, STATE_PAGES, pageById, STATE_PILLAR } from '../../lib/pages';
import type { PageDef, StateDef } from '../../lib/page-types';
export function getStaticPaths() {
  const base = pageById(STATE_PILLAR)?.slug ?? STATE_PILLAR;
  return [
    ...PAGES.map((page) => ({ params: { slug: page.slug }, props: { page, state: undefined } })),
    ...STATE_PAGES.map((state) => ({ params: { slug: `${base}/${state.slug}` }, props: { page: undefined, state } })),
  ];
}
const { page, state } = Astro.props as { page?: PageDef; state?: StateDef };
---
{page ? <ContentPage page={page} /> : <StatePage def={state!} />}
